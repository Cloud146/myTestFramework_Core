<?xml version="1.0" encoding="UTF-8"?>
<configuration>

<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
        <pattern>
            %d{HH:mm:ss} %highlight(%-5level) %msg%n
        </pattern>
    </encoder>
</appender>

<logger name="org.testng" level="WARN"/>
<logger name="io.github.bonigarcia.wdm" level="WARN"/>
<logger name="org.openqa.selenium" level="ERROR"/>
<logger name="org.openqa.selenium.devtools" level="ERROR"/>
<logger name="org.openqa.selenium.chromium" level="ERROR"/>
<logger name="org.testng.internal.Graph" level="INFO"/>

<root level="INFO">
    <appender-ref ref="STDOUT" />
</root>

</configuration>